# ---------------------------------------------------------------------------
# Rockxflow — environment
# Copy to .env.local. Nothing here is required to run the site; every value
# only turns on a real capability (public URL, form delivery, analytics).
# ---------------------------------------------------------------------------

# Canonical origin. Drives <link rel="canonical">, sitemap.xml, robots.txt,
# og:url and twitter:image absolute URLs. When unset, src/lib/seo.ts falls back to
# the placeholder origin https://rockxflow.com — set this to the real host before
# you deploy so social cards and canonicals are correct.
NEXT_PUBLIC_SITE_URL=https://rockxflow.com

# --- Contact form delivery --------------------------------------------------
# The form NEVER pretends to succeed. If no channel below is complete the API
# answers 503 with { ok:false, code:"not_configured", setup.missing:[…] } — the
# exact variable names to set — and the UI shows the WhatsApp / email fallback
# instead of a fake thank-you screen. Server-only: never prefix these with
# NEXT_PUBLIC_, or the values ship to every browser.
# Pick ONE channel (webhook wins if both are set).

# 1) Any HTTP sink: Make, Zapier, n8n, Slack workflow, your own service.
#    Receives POST JSON: name, business, email, phone, topic, message, kind,
#    submittedAt, page, source. Any 2xx counts as delivered, unless the sink
#    answers {"ok": false}, which is reported as a delivery failure.
CONTACT_WEBHOOK_URL=
#    Optional bearer token for a protected receiver (n8n "Auth" header, Make webhooks…).
CONTACT_WEBHOOK_TOKEN=

# 2) Email via Resend (https://resend.com). A test key only delivers to the address
#    verified on your account and must send from onboarding@resend.dev; verify a
#    domain for production. The visitor's address is set as reply_to automatically.
RESEND_API_KEY=
CONTACT_TO_EMAIL=official.rockxflow@gmail.com
CONTACT_FROM_EMAIL="Rockxflow Website <website@resend.dev>"

# --- Static website (npm run build:pages / docs/) ------------------------------------------
# Only used by the static export. A form service endpoint, e.g. a Formspree form URL or a
# Getform/n8n webhook. Leave empty and the static site composes a pre-filled email instead.
NEXT_PUBLIC_FORM_ENDPOINT=

# --- Analytics (optional) ---------------------------------------------------
# No IDs are invented. Events already fire as dataLayer pushes + a
# `rockxflow:event` DOM event; set this to also send a beacon (Plausible-style).
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
